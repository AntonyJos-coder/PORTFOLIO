# Copy this file to .env and fill in your real values.
# NEVER commit .env (with real credentials) to git — only commit this file.

# ── Django core ──────────────────────────────────────────────────────────────
DEBUG=True
# Generate a SECRET_KEY for production:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-this-with-a-long-random-string
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ── Database (Supabase PostgreSQL — Session Pooler) ───────────────────────────
# Supabase Dashboard → Your Project → Connect → Session pooler URI
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DB_SSL_REQUIRE=True

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Requires a Gmail App Password (NOT your regular Gmail password).
# Google Account → Security → 2-Step Verification → App passwords → Create
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
CONTACT_NOTIFY_EMAIL=your-gmail@gmail.com

# ── Supabase Storage (media uploads) ─────────────────────────────────────────
# Enables cloud storage for profile images, project images, and resume uploads.
# Without these, uploaded files are stored on local disk (lost on Render redeploy).
#
# How to set up:
#   1. Supabase Dashboard → Storage → New bucket
#      Name: media   |  Public: ON
#   2. Supabase Dashboard → Project Settings → API
#      Copy "Project URL" → SUPABASE_URL
#      Copy "service_role" secret key → SUPABASE_SERVICE_KEY  (NOT the anon key)
#   3. Supabase Dashboard → Project Settings → General
#      Region shown there → SUPABASE_REGION (e.g. ap-southeast-2)

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-secret-key
SUPABASE_BUCKET=media
SUPABASE_REGION=ap-southeast-2
