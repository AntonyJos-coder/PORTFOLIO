# Copy this file to .env and fill in your real values.
# NEVER commit .env (with real credentials) to git — only commit this file.

DEBUG=True
SECRET_KEY=replace-this-with-a-long-random-string
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# DATABASE_URL format:
#   postgresql://USER:PASSWORD@HOST:PORT/DBNAME
#
# Supabase Session Pooler example (replace YOUR_PASSWORD):
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Vercel production (set these in the Vercel dashboard, not in git):
# DEBUG=False
# SECRET_KEY=<long-random-string>
# DATABASE_URL=<postgres-url>
# ALLOWED_HOSTS=.vercel.app,your-domain.com
# CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://your-domain.com

